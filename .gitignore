# Python
__pycache__/
*.pyc
.venv/
.env

# Agent instruction files (local-only, not shared).
# AGENTS.md holds the shared conventions Claude Code and Codex CLI both read;
# it is kept local for the same reason CLAUDE.md is. Tracking it is a
# publishing decision -- ask first.
.claude/
CLAUDE.md
AGENTS.md

# Local-only docs. INTERNAL: research notes, the bug log, the architecture
# contract, and the steering plans are for the owner, not for the public repo.
# Do not add negations here -- see the note in specs/README or ask first.
docs/

# Internal research material. INTERNAL: the narrative write-ups, the figures and
# the published evidence under reference/, and the prose specifications, decision
# records and evidence under specs/, are the owner's working material. The public
# repository is the code and nothing else.
#
# The single exception is specs/benchmarks/: those JSON files are benchmark
# definitions the code LOADS at runtime, which makes them code. Keep it that way
# -- adding another negation here is a publishing decision, so ask first.
reference/
specs/*
!specs/benchmarks/

# Logs and scratch/temp artifacts
*.log
logs/
.tmp_*
.tmp_rr_*.json
*.tmp
*.tmp.json

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Data
data/raw/
data/processed/
checkpoints/
outputs/
wandb/

# Large archives
*.zip
*.gz
*.tar
*.pt
*.pth
# Model weights in the safetensors format (the pinned p-IgGen release and any
# checkpoint written in it). Same rule as *.pt: the hash is tracked, the bytes
# are not.
*.safetensors

# Local-only machine setup / personal run scripts (kept on disk, never pushed)
pythoncore_3_9_backup.reg
retrain_overnight.ps1
